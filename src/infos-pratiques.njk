<main id="contenu" class="container page" tabindex="-1">
  <h1 class="sr-only">Infos pratiques</h1>
  <div class="info-grid">
    {% for card in contenus.infos %}
    <section aria-labelledby="{{ card.id }}">
      <h2 id="{{ card.id }}">{{ card.titre }}</h2>
      {{ card.html | safe }}
      {% if card.button %}<a class="button" href="{{ card.button.url }}"{% if card.button.url.startsWith('https:') %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ card.button.libelle }} <span aria-hidden="true">↗</span></a>{% endif %}
    </section>
    {% endfor %}
  </div>
</main>
