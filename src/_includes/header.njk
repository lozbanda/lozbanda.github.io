<header class="site-header{% if pageId == 'index' %} home-header{% endif %} container">
  {% if pageId != 'index' %}
  <a class="brand" href="index.html" aria-label="Loz’Banda, accueil">
    <img class="brand-logo" src="assets/logo.webp" width="300" height="240" alt="Logo de Loz’Banda">
  </a>
  {% endif %}
  <div class="header-menu">
  <nav class="site-nav" aria-label="Navigation principale">
    <ul>
      {% for item in site.navigation %}
      <li><a href="{{ item.href }}"{% if pageId == item.id %} aria-current="page"{% endif %}><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{% if item.id == 'agenda' %}<rect x="4" y="5" width="16" height="16" rx="3"/><path d="M8 3v4m8-4v4M4 11h16m-11 4h.01M12 15h.01M16 15h.01"/>{% elif item.id == 'galerie' %}<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="8" cy="9" r="1.5"/><path d="m3 17 5-5 4 4 4-6 5 7"/>{% elif item.id == 'musiciens' %}<circle cx="9" cy="8" r="3"/><path d="M3 21v-2a6 6 0 0 1 12 0v2m1-16a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 5v2"/>{% else %}<circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/>{% endif %}</svg><span>{{ item.label }}</span></a></li>
      {% endfor %}
    </ul>
  </nav>
  {% include "music-player.njk" %}
  </div>
</header>
