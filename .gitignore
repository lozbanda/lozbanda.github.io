# Liste fermée du dépôt public. Ne jamais ajouter les archives privées de l’atelier.
*
!/.gitignore
!/.node-version
!/README.md
!/package.json
!/package-lock.json
!/eleventy.config.js
!/contenu/
!/contenu/*.md
!/src/
!/src/*.njk
!/src/*.js
!/src/*.css
!/src/.nojekyll
!/src/_includes/
!/src/_includes/*.njk
!/src/_data/
!/src/_data/*.js
!/src/assets/
!/src/assets/logo.webp
!/src/assets/logo-accueil.webp
!/src/assets/favicon.png
!/src/assets/audio/
!/src/assets/audio/01-jimmy-sax-no-man-no-cry-live.mp3
!/src/assets/audio/02-lozbanda-la-lozere-bat-des-ailes.mp3
!/src/vendor/
!/src/vendor/fullcalendar/
!/src/vendor/fullcalendar/*
!/build/
!/build/*.mjs
!/build/dev-server/
!/build/dev-server/index.cjs
!/build/dev-server/package.json
!/scripts/
!/scripts/build.mjs
!/scripts/build-maintenance.mjs
!/scripts/check-content.mjs
!/scripts/dev.mjs
!/scripts/lan.py
!/tests/
!/tests/*.test.mjs
!/tests/lan.test.py
!/maintenance/
!/maintenance/index.html
!/maintenance/maintenance.css
!/docs/
!/docs/EDITION.md
!/docs/MAINTENANCE.md
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/.github/workflows/pages.yml
